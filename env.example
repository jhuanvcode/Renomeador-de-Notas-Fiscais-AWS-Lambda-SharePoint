# Copie para .env (NUNCA suba o .env) ou configure em Lambda > Configuration > Environment variables.
# Todos os valores abaixo são fictícios.

# Azure Entra ID (App Registration)
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=troque-por-um-secret-forte

# SharePoint
SHAREPOINT_SITE_URL=https://SUA-EMPRESA.sharepoint.com/sites/SEU-SITE
SHAREPOINT_FOLDER_PATH=Notas Fiscais
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_WATCH_PATHS=
SHAREPOINT_WATCH_YEARS=
SHAREPOINT_TIPOS_PASTA=PDF,XML,CSV

# Regras de negócio
EMPRESA_CNPJ=00.000.000/0001-00
EMPRESA_TERMOS_BLOQUEIO=minhaempresa+matriz|minhaempresa+filial
ARQUIVOS_IGNORADOS=documento-interno-1.pdf,documento-interno-2.pdf

# Webhook Microsoft Graph (obrigatório) - use um valor longo e aleatório
GRAPH_CLIENT_STATE=gere-com-openssl-rand-hex-32

# AWS / comportamento
DYNAMODB_TABLE=notas-processadas
USAR_AWS_TEXTRACT=true
DRY_RUN=true
WEBHOOK_FALLBACK_MINUTES=60
